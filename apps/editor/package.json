{
  "name": "@myblog/editor",
  "version": "1.2.18",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/gen-version.mjs",
    "build:desktop": "pnpm --filter @myblog/shared build && pnpm build && node scripts/bundle-server.mjs",
    "desktop": "tauri dev",
    "pack:web": "pnpm --filter @myblog/shared build && pnpm build && node scripts/bundle-server.mjs && node scripts/pack-web.mjs",
    "pack:macos": "node scripts/pack-desktop.mjs macos",
    "pack:windows": "node scripts/pack-desktop.mjs windows",
    "version:set": "node scripts/set-version.mjs",
    "version:gen": "node scripts/gen-version.mjs",
    "typecheck": "pnpm --filter @myblog/shared build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.30.8",
    "@editorjs/header": "^2.8.8",
    "@editorjs/list": "^2.0.8",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.5",
    "@myblog/shared": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "docx": "9.5.0",
    "docx-preview": "^0.4.1",
    "editorjs-drag-drop": "^1.1.16",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "lucide-react": "1.42.0",
    "mammoth": "^1.8.0",
    "pdfmake": "0.2.20",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-router": "^7",
    "shadcn": "^4.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.8",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.7",
    "vitest": "^5.1.1"
  }
}
